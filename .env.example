# Copy this file to `.env` and fill in the real values.
# Never commit `.env`. Never print these URLs.

# Pooled — Vercel / Next.js runtime (Prisma Client)
# Host must be pooled.db.prisma.io for Prisma Postgres.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Optional alias. If set, the app prefers this over DATABASE_URL at runtime.
DATABASE_URL_POOLED="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct — prisma db push / migrate / Studio only.
# Host must be db.prisma.io. Required because schema.prisma reads DIRECT_URL.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Founder alert. The lead is still saved when these are empty.
RESEND_API_KEY=""
RESEND_FROM="Vamos Properties <leads@example.com>"
LEAD_NOTIFY_EMAIL="patrick@example.com,jaime@example.com"

# Admin sign-in. The session secret must be at least 32 characters.
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL="patrick@example.com"
ADMIN_BOOTSTRAP_NAME="Patrick"
ADMIN_BOOTSTRAP_PASSWORD=""

# Email-to-listing webhook. Secret must be at least 16 characters.
# POST /api/webhooks/listing-email with Authorization: Bearer <secret>
LISTING_EMAIL_WEBHOOK_SECRET=""
ANTHROPIC_API_KEY=""

# Google Tag Manager. Public container ID — safe to expose in the HTML.
NEXT_PUBLIC_GTM_ID="GTM-5XGG59XD"

# Media library. Leave these empty until the S3 bucket is ready.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_S3_PUBLIC_BASE_URL=""

# Google Sheets catalog. Parallel to Prisma listings. Read-only.
# Paste the private key with \n for newlines. Never commit the JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID="1Y-yKApzZxga27DKdRWCwGKs4Yju31hODJud048pcURg"
GOOGLE_SHEET_TAB=""

# Sheet → Postgres sync. Secret must be at least 16 characters.
# POST /api/sheet-listings/sync with Authorization: Bearer <secret>
SHEET_SYNC_SECRET=""
