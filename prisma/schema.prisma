// Prisma 5 schema for PostgreSQL (Vercel Postgres / local).
// Apply: npx prisma db push
// Generate client: npx prisma generate  (also runs on npm postinstall)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  name          String
  role          String       @default("owner")
  passwordHash  String
  assignedLeads Lead[]
  events        LeadEvent[]
  mediaAssets   MediaAsset[]
  posts         Post[]
  comments      Comment[]
  createdAt     DateTime     @default(now())
}

model Lead {
  id              Int         @id @default(autoincrement())
  address         String
  unit            String?
  city            String?
  name            String
  phone           String
  email           String?
  message         String?     @db.Text
  situation       String
  trusteeSaleDate String?
  preferredPath   String
  language        String
  status          String      @default("new")
  lostReason      String?
  sourcePath      String
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  assignedToId    Int?
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  consents        Consent[]
  events          LeadEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([trusteeSaleDate])
  @@index([assignedToId])
}

model Consent {
  id          Int      @id @default(autoincrement())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int
  channel     String
  textVersion String   @db.Text
  pageUrl     String   @db.Text
  ipHash      String
  grantedAt   DateTime @default(now())

  @@index([leadId])
}

model LeadEvent {
  id         Int      @id @default(autoincrement())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     Int
  author     String   @default("system")
  authorId   Int?
  authorUser User?    @relation(fields: [authorId], references: [id])
  type       String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([authorId])
}

model Listing {
  id              Int            @id @default(autoincrement())
  title           String
  slug            String         @unique
  address         String
  city            String?
  beds            Int?
  baths           String?
  sqft            Int?
  propertyType    String?
  price           String?
  listPrice       Int?
  previousPrice   Int?
  priceChangedAt  DateTime?
  monthlyPayment  Int?
  terms           String?        @db.Text
  status          String         @default("draft")
  featured        Boolean        @default(false)
  summary         String?        @db.Text
  description     String?        @db.Text
  features        String?        @db.Text
  neighborhood    String?        @db.Text
  schools         String?        @db.Text
  yearBuilt       Int?
  metaTitle       String?
  metaDescription String?
  keywords        String?        @db.Text
  localTags       String?        @db.Text
  photos          String?        @db.Text
  arv             Int?
  driveFolderUrl  String?        @db.Text
  source          String         @default("manual")
  sourceMessageId String?        @unique
  addressKey      String?
  publishedAt     DateTime?
  prices          ListingPrice[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([city])
  @@index([listPrice])
  @@index([featured])
  @@index([addressKey])
  @@index([source])
}

model ListingPrice {
  id             Int      @id @default(autoincrement())
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId      Int
  amount         Int
  previousAmount Int?
  recordedAt     DateTime @default(now())

  @@index([listingId])
}

model SheetListing {
  id              Int       @id @default(autoincrement())
  sheetKey        String    @unique
  slug            String    @unique
  listingCode     String?   @unique
  title           String
  address         String
  addressKey      String
  city            String?
  listPrice       Int?
  previousPrice   Int?
  drop            Int?
  priceChangedAt  DateTime?
  priceDropped    Boolean   @default(false)
  updated         Boolean   @default(false)
  arv             Int?
  beds            Int?
  baths           String?
  sqft            Int?
  propertyType    String?
  status          String    @default("active")
  description     String?   @db.Text
  photos          String?   @db.Text
  galleries       String?   @db.Text
  coverPhoto      String?   @db.Text
  driveFolderUrl  String?   @db.Text
  hoa             String?
  ac              String?
  roof            String?
  waterHeater     String?
  titleCompany    String?
  sourceMessageId String?
  listedAt        String?
  sheetUpdatedAt  String?
  priceHistory    String?   @db.Text
  updateNotes     String?   @db.Text
  metaTitle       String?
  metaDescription String?   @db.Text
  metaKeywords    String?   @db.Text
  localTargetArea String?
  canonicalUrl    String?   @db.Text
  schemaJsonLd    String?   @db.Text
  latitude        Float?
  longitude       Float?
  sheetSyncStatus String?
  sheetSyncedAt   String?
  sheetRow        Int?
  contentHash     String
  manualHold      Boolean   @default(false)
  removedAt       DateTime?
  syncedAt        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, addressKey, listPrice])
  @@index([removedAt])
  @@index([localTargetArea])
}

model SheetSyncLock {
  id       Int       @id @default(1)
  holder   String?
  lockedAt DateTime?
}

model SheetSyncRun {
  id                Int              @id @default(autoincrement())
  errorId           String           @unique
  trigger           String
  status            String
  startedAt         DateTime         @default(now())
  finishedAt        DateTime?
  rows              Int              @default(0)
  uniqueCount       Int              @default(0)
  createdCount      Int              @default(0)
  updatedCount      Int              @default(0)
  unchangedCount    Int              @default(0)
  heldCount         Int              @default(0)
  inactivatedCount  Int              @default(0)
  skippedJson       String?          @db.Text
  error             String?
  events            SheetSyncEvent[]

  @@index([startedAt])
  @@index([status])
}

model SheetSyncEvent {
  id          Int          @id @default(autoincrement())
  runId       Int
  run         SheetSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  listingCode String?
  sheetKey    String?
  slug        String?
  action      String
  reason      String
  createdAt   DateTime     @default(now())

  @@index([runId])
  @@index([slug])
  @@index([listingCode])
}

model MediaAsset {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  url         String   @db.Text
  fileName    String
  contentType String
  kind        String
  sizeBytes   Int
  folder      String?
  alt         String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([folder])
  @@index([createdAt])
  @@index([createdById])
}

model Post {
  id               Int            @id @default(autoincrement())
  slug             String         @unique
  title            String
  excerpt          String?        @db.Text
  body             String         @db.Text
  status           String         @default("draft")
  featuredImageUrl String?        @db.Text
  featuredImageAlt String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?        @db.Text
  ogImageUrl       String?        @db.Text
  publishedAt      DateTime?
  author           User?          @relation(fields: [authorId], references: [id])
  authorId         Int?
  categories       PostCategory[]
  tags             PostTag[]
  comments         Comment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model Category {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  name        String
  description String?        @db.Text
  parent      Category?      @relation("CategoryParent", fields: [parentId], references: [id])
  parentId    Int?
  children    Category[]     @relation("CategoryParent")
  posts       PostCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
}

model Tag {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  posts     PostTag[]
  createdAt DateTime  @default(now())
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model PostTag {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Comment {
  id          Int       @id @default(autoincrement())
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    Int?
  replies     Comment[] @relation("CommentThread")
  author      User?     @relation(fields: [authorId], references: [id])
  authorId    Int?
  authorName  String
  authorEmail String?
  body        String    @db.Text
  status      String    @default("pending")
  isStaff     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([status])
  @@index([authorId])
}
